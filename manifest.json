{
  "manifest_version": 3,
  "name": "YouTube Clean",
  "version": "1.1.0",
  "description": "High-fidelity, transparent YouTube ad prevention and playback preservation",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["bridge.js", "fallback.js"],
      "css": ["cosmetic.css"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_youtube",
        "enabled": true,
        "path": "rules/youtube.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "YouTube Clean"
  }
}
